{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "README.md",
      "CHANGELOG.md",
      "VERSION",
      "admin-portal/**",
      "functions/**",
      "functions-leadmagnet/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
        ]
      }
    ],
    "rewrites": [
      { "source": "/api/gmailAuthUrl", "function": { "functionId": "gmailAuthUrl", "region": "us-central1" } },
      { "source": "/api/gmailOauthCallback", "function": { "functionId": "gmailOauthCallback", "region": "us-central1" } },
      { "source": "/api/meetingPrep", "function": { "functionId": "meetingPrep", "region": "us-central1" } },
      { "source": "/api/fetchIntakeResponses", "function": { "functionId": "fetchIntakeResponses", "region": "us-central1" } },
      { "source": "/admin/**", "destination": "/admin/index.html" }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    },
    {
      "source": "functions-leadmagnet",
      "codebase": "leadmagnet",
      "runtime": "nodejs20"
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
